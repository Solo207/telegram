# From https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
# Output of: node generate-session.js
TG_SESSION=

# Secret that n8n must send in the x-api-key header
API_KEY=change-me-to-a-long-random-string

# n8n Webhook node (Production URL) that receives new messages
N8N_WEBHOOK_URL=
# Optional: sent as x-webhook-secret header (use Header Auth in the n8n Webhook node)
N8N_WEBHOOK_SECRET=

# How n8n reaches this service (EasyPanel internal host), used to build downloadUrl
SELF_URL=http://project_tg-gateway:3000

MAX_DOWNLOAD_MB=50
PORT=3000
